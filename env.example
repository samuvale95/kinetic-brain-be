# AWS Secrets Manager (for database credentials)
# If AWS_SECRET_NAME is set, database credentials will be retrieved from AWS Secrets Manager
# Otherwise, DATABASE_URL and DATABASE_URL_ASYNC will be used
AWS_SECRET_NAME=rds!db-f609f1db-d7a1-4220-afbc-3679b06248bd
AWS_REGION=eu-north-1

# AWS Credentials (required if using AWS Secrets Manager)
# Option 1: Use environment variables (recommended for local development)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# 
# Option 2: Use AWS credentials file at ~/.aws/credentials (alternative)
# [default]
# aws_access_key_id = your-access-key-id
# aws_secret_access_key = your-secret-access-key
# region = eu-north-1

# Database connection details (if not in AWS secret)
# These are used as fallback if the secret doesn't contain host/dbname
# DB_HOST=your-database-host.rds.amazonaws.com
# DB_NAME=your-database-name
# DB_PORT=5432

# Database (fallback if AWS_SECRET_NAME is not set)
DATABASE_URL=postgresql://user:password@localhost/kinetic_brain
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@localhost/kinetic_brain

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic/Claude (for plan review)
ENABLE_CLAUDE_REVIEW=false
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
CLAUDE_REVIEW_PERCENTAGE=20

# Plan limits
MAX_PLAN_DURATION_WEEKS=24

# Weather
WEATHER_API_KEY=your-openweathermap-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# CORS
CORS_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080"]

# Redis (optional)
REDIS_URL=redis://localhost:6379

# App
APP_NAME=Kinetic Brain API
APP_VERSION=1.0.0
DEBUG=false

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_FOLDER=uploads
# Logging
LOG_LEVEL=INFO
