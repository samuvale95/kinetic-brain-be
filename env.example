# AWS Secrets Manager (for database credentials)
# If AWS_SECRET_NAME is set, database credentials will be retrieved from AWS Secrets Manager
# Otherwise, DATABASE_URL and DATABASE_URL_ASYNC will be used
AWS_SECRET_NAME=rds!db-f609f1db-d7a1-4220-afbc-3679b06248bd
AWS_REGION=eu-north-1

# AWS Credentials (required if using AWS Secrets Manager)
# Option 1: Use environment variables (recommended for local development)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# 
# Option 2: Use AWS credentials file at ~/.aws/credentials (alternative)
# [default]
# aws_access_key_id = your-access-key-id
# aws_secret_access_key = your-secret-access-key
# region = eu-north-1

# Database connection details (if not in AWS secret)
# These are used as fallback if the secret doesn't contain host/dbname
# DB_HOST=your-database-host.rds.amazonaws.com
# DB_NAME=your-database-name
# DB_PORT=5432

# Database (fallback if AWS_SECRET_NAME is not set)
DATABASE_URL=postgresql://user:password@localhost/kinetic_brain
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@localhost/kinetic_brain

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic/Claude (for plan review)
ENABLE_CLAUDE_REVIEW=false
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
CLAUDE_REVIEW_PERCENTAGE=20

# Plan limits
MAX_PLAN_DURATION_WEEKS=24

# Weather
WEATHER_API_KEY=your-openweathermap-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
# Additional Google Client IDs (comma-separated) for React Native Android/iOS apps
# Only needed if your mobile app uses different Client IDs than the web one
# GOOGLE_ADDITIONAL_CLIENT_IDS=142196029321-android-id.apps.googleusercontent.com,142196029321-ios-id.apps.googleusercontent.com

# Apple OAuth
APPLE_CLIENT_ID=your-apple-service-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----
APPLE_REDIRECT_URI=http://localhost:8080/auth/apple/callback

# CORS
CORS_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080"]

# Redis (optional)
REDIS_URL=redis://localhost:6379

# App
APP_NAME=Kinetic Brain API
APP_VERSION=1.0.0
DEBUG=false

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_FOLDER=uploads
# Logging
LOG_LEVEL=INFO

# Email Configuration
# SMTP settings for sending emails (password reset, feedback notifications)
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password_or_app_password
MAIL_FROM=noreply@kineticbrain.com
MAIL_FROM_NAME=Kinetic Brain
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Application URLs
FRONTEND_URL=http://localhost:8080
ADMIN_EMAIL=admin@kineticbrain.com

# Firebase Cloud Messaging (FCM) for push notifications - API V1
# FCM API V1 requires a Service Account JSON instead of Server Key
# See docs/FIREBASE_SETUP.md for complete setup instructions
# 
# FCM_PROJECT_ID: Your Firebase project ID (found in Firebase Console > Project Settings > General)
FCM_PROJECT_ID=your-fcm-project-id
#
# FCM_SERVICE_ACCOUNT_JSON: Service Account JSON as a single-line string
# Get this from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Format: {"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
# IMPORTANT: Escape quotes and newlines if setting as environment variable, or use a JSON file path
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}
#
# DEPRECATED: FCM_SERVER_KEY (Legacy API - no longer supported)
# FCM_SERVER_KEY=your-fcm-server-key

# Internal API Secret (for cron jobs and internal endpoints)
# Generate a secure random string (e.g., with: openssl rand -hex 32)
INTERNAL_API_SECRET=your-internal-api-secret-here

# Scheduled Tasks Provider
# Options:
#   - "render_cron": Use Render Cron Jobs (external HTTP calls to /notifications/cron/send-workout-reminders)
#   - "apscheduler": Use APScheduler (in-process scheduler, no external setup needed)
SCHEDULED_TASKS_PROVIDER=render_cron

# APScheduler Configuration (only used if SCHEDULED_TASKS_PROVIDER=apscheduler)
# Cron expressions for workout reminders (format: minute hour day month day_of_week)
# Examples:
#   "0 8 * * *"  = Every day at 8:00 AM UTC
#   "0 18 * * *" = Every day at 6:00 PM UTC
#   ""           = Disabled
WORKOUT_REMINDER_MORNING_CRON=0 8 * * *
WORKOUT_REMINDER_EVENING_CRON=0 18 * * *

# Note for Gmail:
# If using Gmail, you may need to:
# 1. Enable "Less secure app access" (not recommended)
# 2. Or create an "App Password" in your Google Account settings
#    (Settings > Security > 2-Step Verification > App passwords)
