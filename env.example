# =============================================================================
# Kinetic Brain Backend - Environment Variables Configuration
# =============================================================================
# 
# Questo file contiene tutte le variabili d'ambiente disponibili per il backend.
# Copia questo file come `.env` e compila i valori necessari per il tuo ambiente.
#
# IMPORTANTE: Non committare il file `.env` con valori reali nel repository!
# =============================================================================

# =============================================================================
# AWS SECRETS MANAGER (Database Credentials)
# =============================================================================
# Se AWS_SECRET_NAME è impostato, le credenziali del database verranno recuperate
# da AWS Secrets Manager. Altrimenti, verranno usate DATABASE_URL e DATABASE_URL_ASYNC.
#
# Opzione 1: Usa AWS Secrets Manager (consigliato per produzione)
# AWS_SECRET_NAME=rds!db-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AWS_REGION=eu-north-1
#
# Opzione 2: Usa variabili d'ambiente per credenziali AWS (sviluppo locale)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
#
# Opzione 3: Usa file ~/.aws/credentials (alternativa)
# [default]
# aws_access_key_id = your-access-key-id
# aws_secret_access_key = your-secret-access-key
# region = eu-north-1

AWS_SECRET_NAME=
AWS_REGION=eu-north-1

# Credenziali AWS (richieste se si usa AWS Secrets Manager)
# Lasciare vuote se si usa IAM role o ~/.aws/credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Dettagli connessione database (se non nel secret AWS)
# Questi vengono usati come fallback se il secret non contiene host/dbname
DB_HOST=
DB_NAME=
DB_PORT=5432

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# URL di connessione al database PostgreSQL.
# Usato solo se AWS_SECRET_NAME non è impostato.
#
# Formato: postgresql://username:password@host:port/database_name
# Esempio: postgresql://user:password@localhost:5432/kinetic_brain

DATABASE_URL=postgresql://user:password@localhost/kinetic_brain
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@localhost/kinetic_brain

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# Secret key per JWT token signing. DEVE essere cambiato in produzione!
# Genera una chiave sicura con: openssl rand -hex 32

SECRET_KEY=your-secret-key-change-in-production

# Algoritmo per JWT (default: HS256)
ALGORITHM=HS256

# Durata token di accesso (in minuti)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Durata refresh token (in giorni)
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# Configurazione per integrazione OpenAI (generazione piani di allenamento)
#
# Ottieni la tua API key da: https://platform.openai.com/api-keys

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT_SECONDS=120

# =============================================================================
# ANTHROPIC/CLAUDE CONFIGURATION
# =============================================================================
# Configurazione per Anthropic Claude (review automatico dei piani generati)
#
# Ottieni la tua API key da: https://console.anthropic.com/
#
# ENABLE_CLAUDE_REVIEW: Abilita il review automatico dei piani con Claude
# CLAUDE_REVIEW_PERCENTAGE: Percentuale di piani da sottoporre a review (0-100)
# ANTHROPIC_MODEL: Modello Claude da usare
# ANTHROPIC_TIMEOUT_SECONDS: Timeout per chiamate API (secondi)

ENABLE_CLAUDE_REVIEW=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
CLAUDE_REVIEW_PERCENTAGE=20
ANTHROPIC_TIMEOUT_SECONDS=120

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================
# Configurazione per autenticazione Google OAuth
#
# Crea le credenziali OAuth da: https://console.cloud.google.com/apis/credentials
# 
# GOOGLE_CLIENT_ID: Client ID OAuth 2.0
# GOOGLE_CLIENT_SECRET: Client Secret OAuth 2.0
# GOOGLE_REDIRECT_URI: URI di redirect per callback (backend)
# FRONTEND_CALLBACK_URI: URI di redirect per callback (frontend)
# GOOGLE_ADDITIONAL_CLIENT_IDS: Client IDs aggiuntivi per app mobile (comma-separated)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_CALLBACK_URI=http://localhost:8080/auth/callback
GOOGLE_ADDITIONAL_CLIENT_IDS=

# =============================================================================
# APPLE OAUTH CONFIGURATION
# =============================================================================
# Configurazione per autenticazione Apple Sign In
#
# Crea le credenziali da: https://developer.apple.com/account/resources/identifiers/list
#
# APPLE_CLIENT_ID: Service ID da Apple Developer
# APPLE_TEAM_ID: Team ID da Apple Developer
# APPLE_KEY_ID: Key ID per JWT client secret
# APPLE_PRIVATE_KEY: Chiave privata per generare JWT client secret (formato PEM)
# APPLE_REDIRECT_URI: URI di redirect per callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----
APPLE_REDIRECT_URI=http://localhost:8080/auth/apple/callback

# =============================================================================
# STRAVA OAUTH CONFIGURATION
# =============================================================================
# Configurazione per integrazione Strava
#
# Crea l'app da: https://www.strava.com/settings/api
#
# STRAVA_CLIENT_ID: Client ID Strava
# STRAVA_CLIENT_SECRET: Client Secret Strava
# STRAVA_REDIRECT_URI: URI di redirect per callback OAuth
# STRAVA_WEBHOOK_VERIFY_TOKEN: Token di verifica per webhook Strava

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Origini consentite per CORS (formato JSON array)
# Aggiungi gli URL del tuo frontend (web e mobile se necessario)
#
# Esempio: ["http://localhost:8080", "https://app.kineticbrain.com"]

CORS_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080"]

# =============================================================================
# REDIS CONFIGURATION (Optional)
# =============================================================================
# URL di connessione a Redis per caching e rate limiting
#
# Formato: redis://host:port o redis://password@host:port
# Esempio: redis://localhost:6379

REDIS_URL=redis://localhost:6379

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Configurazione generale dell'applicazione

APP_NAME=Kinetic Brain API
APP_VERSION=1.0.0

# Modalità debug (true/false)
# In produzione: false
# In sviluppo: true
DEBUG=false

# Livello di logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Disabilita OpenAPI/Swagger docs (true/false)
# In produzione: true (per sicurezza)
# In sviluppo: false
DISABLE_OPENAPI=false

# Modalità startup minimale (true/false)
# Usa true solo per health checks senza dipendenze
MINIMAL_STARTUP=false

# =============================================================================
# FILE UPLOADS
# =============================================================================
# Configurazione per upload file
#
# MAX_FILE_SIZE: Dimensione massima file in bytes (default: 5MB = 5242880)
# UPLOAD_FOLDER: Cartella dove salvare i file caricati

MAX_FILE_SIZE=5242880
UPLOAD_FOLDER=uploads

# =============================================================================
# PLAN GENERATION LIMITS
# =============================================================================
# Limiti per generazione piani di allenamento
#
# MAX_PLAN_DURATION_WEEKS: Durata massima di un piano in settimane

MAX_PLAN_DURATION_WEEKS=24

# =============================================================================
# WEATHER API CONFIGURATION
# =============================================================================
# Configurazione per API meteo
#
# WEATHER_API_KEY: API key per OpenWeatherMap (opzionale)
# Se non fornita, viene usato Open-Meteo (gratuito, nessuna API key richiesta)

WEATHER_API_KEY=

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Configurazione SMTP per invio email
# (password reset, notifiche feedback, etc.)
#
# MAIL_USERNAME: Username SMTP (spesso l'indirizzo email)
# MAIL_PASSWORD: Password SMTP o App Password
# MAIL_FROM: Indirizzo email mittente
# MAIL_FROM_NAME: Nome mittente
# MAIL_PORT: Porta SMTP (587 per STARTTLS, 465 per SSL)
# MAIL_SERVER: Server SMTP
# MAIL_STARTTLS: Usa STARTTLS (true/false)
# MAIL_SSL_TLS: Usa SSL/TLS diretto (true/false)
#
# Note per Gmail:
# - Devi creare una "App Password" da Google Account Settings
# - Non usare la password normale dell'account
# - Vai su: Settings > Security > 2-Step Verification > App passwords

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@kineticbrain.com
MAIL_FROM_NAME=Kinetic Brain
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# =============================================================================
# APPLICATION URLs
# =============================================================================
# URL dell'applicazione frontend e email admin
#
# FRONTEND_URL: URL base del frontend
# ADMIN_EMAIL: Email dell'amministratore (per notifiche, supporto, etc.)

FRONTEND_URL=http://localhost:8080
ADMIN_EMAIL=admin@kineticbrain.com

# =============================================================================
# FIREBASE CLOUD MESSAGING (FCM) - Push Notifications
# =============================================================================
# Configurazione per notifiche push tramite Firebase Cloud Messaging API V1
#
# IMPORTANTE: FCM API V1 richiede un Service Account JSON invece della Server Key
# Vedi docs/FIREBASE_SETUP.md per istruzioni complete
#
# FCM_PROJECT_ID: ID del progetto Firebase
#   Trovalo in: Firebase Console > Project Settings > General
#
# FCM_SERVICE_ACCOUNT_JSON: Service Account JSON come stringa single-line
#   Ottienilo da: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
#   Formato: {"type":"service_account","project_id":"...","private_key":"...",...}
#   IMPORTANTE: Escape quotes e newlines se impostato come variabile d'ambiente
#
# FCM_SERVER_KEY: DEPRECATO - Non più supportato (mantenuto per compatibilità)

FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
FCM_SERVER_KEY=

# =============================================================================
# INTERNAL API SECRET
# =============================================================================
# Secret per endpoint interni e cron jobs
# Genera una stringa sicura con: openssl rand -hex 32
#
# Usato per proteggere endpoint chiamati da cron jobs esterni (es. Render Cron Jobs)

INTERNAL_API_SECRET=

# =============================================================================
# SCHEDULED TASKS CONFIGURATION
# =============================================================================
# Configurazione per task schedulati (notifiche workout reminders)
#
# SCHEDULED_TASKS_PROVIDER: Provider per task schedulati
#   - "render_cron": Usa Render Cron Jobs (chiamate HTTP esterne a /notifications/cron/send-workout-reminders)
#   - "apscheduler": Usa APScheduler (scheduler in-process, nessuna configurazione esterna)
#
# WORKOUT_REMINDER_MORNING_CRON: Espressione cron per reminder mattutini
#   Formato: minute hour day month day_of_week
#   Esempio: "0 8 * * *" = Ogni giorno alle 8:00 AM UTC
#   Lascia vuoto ("") per disabilitare
#
# WORKOUT_REMINDER_EVENING_CRON: Espressione cron per reminder serali
#   Formato: minute hour day month day_of_week
#   Esempio: "0 18 * * *" = Ogni giorno alle 6:00 PM UTC
#   Lascia vuoto ("") per disabilitare

SCHEDULED_TASKS_PROVIDER=render_cron
WORKOUT_REMINDER_MORNING_CRON=0 8 * * *
WORKOUT_REMINDER_EVENING_CRON=0 18 * * *

# =============================================================================
# MOCK/TESTING CONFIGURATION
# =============================================================================
# Configurazione per testing e sviluppo
#
# MOCK_LLM: Usa mock per chiamate LLM invece di OpenAI/Claude (true/false)
#   Utile per testing senza consumare crediti API
#
# MOCK_PROGRESSIVE_ALWAYS_ALLOW_GENERATION: 
#   Permetti sempre generazione settimana successiva nei piani progressivi (true/false)
#   Utile per testing senza aspettare i limiti temporali

MOCK_LLM=false
MOCK_PROGRESSIVE_ALWAYS_ALLOW_GENERATION=false

# =============================================================================
# NOTE FINALI
# =============================================================================
#
# 1. Copia questo file come `.env` nella root del progetto
# 2. Compila solo le variabili necessarie per il tuo ambiente
# 3. Non committare mai il file `.env` con valori reali!
# 4. Per produzione, usa variabili d'ambiente del sistema o secrets manager
# 5. Per sviluppo locale, puoi lasciare molti valori vuoti se non usi quelle funzionalità
#
# Variabili MINIME necessarie per far partire l'applicazione:
# - DATABASE_URL (o AWS_SECRET_NAME con credenziali AWS)
# - SECRET_KEY
# - OPENAI_API_KEY (se vuoi generare piani di allenamento)
#
# Tutte le altre sono opzionali e possono essere lasciate vuote se non usate.
# =============================================================================
